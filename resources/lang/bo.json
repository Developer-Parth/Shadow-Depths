  "talk_wizard_1": "བཀྲ་ཤིས་བདེ་ལེགས། གཞོན་ནུའི་དཔའ་བོ།\nཁྱེད་ཀྱིས་འདི་ནས་ཅི་ཞིག་བྱེད་ཀྱིན་ཡིན།",
  "talk_player_1": "བཀྲ་ཤིས་བདེ་ལེགས།\nའདི་འཁོར་གྱི་ས་ཁུལ་དུ་སྡོད་པའི་འབྱུང་པོ་ཚོས་བུ་ཆུང་ཞིག་འཕྲོག་སྟེ་བསྐྱལ་བ་ཡིན། ང་དེ་བསྐྱབས་ཀྱི་ཕྱིར་སླེབས་པ་ཡིན།",
  "talk_wizard_2": "ཧེ་ཧེ་ཧེ་...\nཁྱེད་ལ་ཉེན་བརྡ་གཏང་འདོད་མི་འདུག འོན་ཀྱང་ཁྱེད་ནི་ལས་འདིར་བཏང་བའི་དཔའ་བོ་ལྔ་པ་ཡིན། ད་བར་དུ་གཅིག་ཀྱང་གསོན་པོར་ཕྱིར་མ་ལོག ཁོ་ཚོའི་ལུས་པོ་དཔྱད་གཞི་བཞིན་རྩིག་ལོགས་སུ་འཕེན་ཡོད།",
  "talk_player_2": "སེམས་མི་བདེ་བ་མ་གནང་། བཀྲིས། ཁྱེད་ལྟ་བུའི་དཔའ་བོ་བྱུང་མྱོང་མི་འདུག\nངས་འདི་ནས་འབྱུང་པོ་ཚང་མ་བསད་ནས་བུ་ཆུང་དེ་བསྐྱབས་ཀྱི་ཡིན།",
  "talk_wizard_3": "འདུག ཁྱེད་ལ་མ་འདང་བ་ནི་སྤོབས་པ་རེད།\nདེ་ནས་ངས་བརྡ་མ་བཏང་ཟེར་མ་གནང་།\nབཀྲ་ཤིས་བདེ་ལེགས།",
  "talk_kid_1": "རོགས་སྐྱོབས། རོགས་སྐྱོབས།",
  "talk_boss_1": "སྐད་ཆ་སྒྲོམ། ཁྱེད་ཀྱི་ཟས་ལ་འཕྲོད་པའི་འབྱུང་པོ་ཆུང་ཆུང་།\nཁྱེད་ཀྱི་མཉེན་པའི་པགས་པ་ཟ་བའི་དུས་ལ་སླེབས་སོང་། ཧེ་ཧེ་ཧེ་ཧེ།",
  "talk_player_3": "ད་ཐེངས་ཁྱེད་ཀྱི་སྐྱག་སྒྲོག་འབྱུང་པོ་མིན།\nཁྱེད་ཀྱི་འཇིགས་སྐྱོན་གྱི་ཉིན་མོ་རྫོགས་སོང་།",
  "talk_boss_2": "བལྟ། ཁྱེད་ལ་རང་ལ་མཚན་སྙན་ཐོག་ཏུ་འཛེགས་མཁན་གྱི་དཔའ་བོ་གཞན་ཞིག!\nང་ལ་བཀག་ཐུབ་བསམ་གྱི་འདུག! ཧེ་ཧེ་ཧེ་ཧེ།\nའདི་རུ་ཡོང་།",
  "talk_kid_2": "ལྷ་ཚོར་བཀའ་དྲིན་ཆེ། !!!\nཁྱེད་ཀྱིས་འབྱུང་པོ་འདི་འཇིགས་སུ་རུང་བ་ལས་རྒྱལ་སོང་། ཐུགས་རྗེ་ཆེ།\nཁྱེད་ལ་ཐུགས་རྗེ་ཇི་ལྟར་འཚལ་དགོས་པ་ཤེས་ཀྱི་མི་འདུག",
  "talk_player_4": "ཁྱེད་ལ་རོགས་རམ་བྱེད་ཐུབ་པ་དེ་གཟི་བརྗིད་ཆེན་པོ་ཞིག་རེད། བྱིན་རྟགས་སྐོར་ལ་སེམས་མི་བདེ་བ་མ་གནང་། ཁྱེད་ཀྱི་ཕ་ལོས་ང་ལ་ཁྱེད་བསྐྱབས་ན་རྒྱུ་ནོར་མང་པོ་སྟེར་རྒྱུ་ཁས་བླངས་བ་ཡིན། :-)",
  "play_again_cap": "བསྐྱར་རྩེད།",
